[Unit]
Description=Offshelf server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
User=offshelf
Group=offshelf
Environment=OSHELF_DATA_DIR=/var/lib/offshelf
ExecStart=/usr/local/bin/oshelfd serve
# /run/offshelf holds the control socket, so `oshelfd pair` works for any
# user without sudo.
RuntimeDirectory=offshelf
RuntimeDirectoryMode=0755
Restart=on-failure

[Install]
WantedBy=multi-user.target
